GEMINI_API_KEY=여기에_Gemini_API_키_입력
GEMINI_MODEL=gemini-2.0-flash
FIREBASE_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}

JUSO_SEARCH_API_KEY=여기에_도로명주소_검색_API_승인키_입력
JUSO_COORD_API_KEY=여기에_좌표제공_검색_API_승인키_입력
RESEND_API_KEY=여기에_Resend_API_키_입력
TOURNAMENT_SUBMISSION_EMAIL_FROM=AllRound <noreply@example.com>
TOURNAMENT_SUBMISSION_TENNIS_EMAIL=준모_이메일_주소
TOURNAMENT_SUBMISSION_FUTSAL_EMAIL=주희_이메일_주소


# ── 전화번호 SMS 인증 (send-otp / verify-otp) ──────────────────────
# 전화번호 해시용 pepper. 절대 커밋·로그 노출 금지.
#   openssl rand -hex 32
# 주의: 원문 번호를 저장하지 않으므로 이 값을 바꾸면 기존 phone_hash 를
# 재계산할 수 없다(전원 재인증 필요). 교체 시 users.pepper_version 활용.
PHONE_HASH_PEPPER=여기에_openssl_rand_hex_32_결과_입력

# 솔라피 SOLAPI (SMS 발송)
# 키는 콘솔 > 개발/연동 > API Key 에서 발급한다. Secret 은 발급 화면에서 한 번만 보인다.
SOLAPI_API_KEY=여기에_솔라피_API_키
SOLAPI_API_SECRET=여기에_솔라피_API_시크릿
# 사전 등록·승인된 발신번호만 쓸 수 있다(전기통신사업법 §84조의2).
SOLAPI_FROM=16661042

# OTP 발송 상한 (미설정 시 기본값 사용)
OTP_DAILY_GLOBAL_CAP=2000
OTP_USER_DAILY_CAP=5
